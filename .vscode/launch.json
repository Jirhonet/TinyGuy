{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "LVGL: Debug emulator",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/tiny-guy-sim",
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "LVGL: build",
      "setupCommands": [
        {
          "description": "Enable GDB pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}

